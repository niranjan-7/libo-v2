# ==========================================
# LIBRARY PLATFORM ENVIRONMENT CONFIGURATION
# ==========================================

# Application Port & Environment
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Control-Plane PostgreSQL Database
CONTROL_PLANE_DB_HOST=localhost
CONTROL_PLANE_DB_PORT=5432
CONTROL_PLANE_DB_USER=postgres
CONTROL_PLANE_DB_PASSWORD=postgres
CONTROL_PLANE_DB_NAME=control_plane_db
CONTROL_PLANE_DB_LOGGING=false

# Tenant Database Provisioning Template
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_USER=postgres
TENANT_DB_PASSWORD=postgres
TENANT_DB_TEMPLATE_NAME=tenant_template_db

# Security & JWT Tokens
JWT_SECRET=super_secret_jwt_key_for_development_minimum_32_characters_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend Configuration (apps/web)
VITE_API_URL=http://localhost:3000/api/v1
